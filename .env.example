# Copy to .env to override defaults. All vars are prefixed ROBO_.

# Force backends (otherwise auto-detected by platform):
#   ROBO_HARDWARE=fake|gpiozero
#   ROBO_SPEECH=mac|piper|fake
# ROBO_HARDWARE=fake
# ROBO_SPEECH=mac

# Web server
# ROBO_HOST=0.0.0.0
# ROBO_PORT=8000

# Voice / speech-to-text (needs the `voice` extra).
# ROBO_STT=whisper|fake            # auto-detects whisper if installed
# ROBO_WHISPER_MODEL=tiny.en       # tiny.en|base.en|small.en
# ROBO_WHISPER_COMPUTE=int8        # int8 (fast on Pi) | auto
# ROBO_WAKE_WORD=robo              # only act on "robo, ..." (blank = always)
# ROBO_MIC_DEVICE=                 # sounddevice index; blank = system default
# ROBO_VAD_START=0.02              # RMS level to trigger an utterance
# ROBO_VAD_SILENCE_S=0.8           # silence (s) that ends an utterance

# AI brain (Claude). Enable + provide a key to supercharge command understanding.
# ROBO_BRAIN_ENABLED=true
# ROBO_ANTHROPIC_API_KEY=sk-ant-...   # or set ANTHROPIC_API_KEY / `ant auth login`
# ROBO_BRAIN_MODEL=claude-opus-4-8
# ROBO_BRAIN_EFFORT=low               # low|medium|high|max (low = snappiest reflexes)
