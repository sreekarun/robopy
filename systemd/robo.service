# Install on the Raspberry Pi 5:
#   sudo cp systemd/robo.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now robo
#   journalctl -u robo -f      # logs
[Unit]
Description=Robo robot controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/robopy
Environment=ROBO_HARDWARE=auto
Environment=ROBO_SPEECH=auto
# To enable the AI brain, drop an EnvironmentFile with the key instead of inlining it:
# EnvironmentFile=/home/pi/robopy/.env
ExecStart=/home/pi/robopy/.venv/bin/robo
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
